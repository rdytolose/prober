# Prober deployment template.  Copy to .env and fill in.

# Unique human-readable name (shows up in the dashboard).
PROBER_NAME=de-1

# Full URL of the coordinator (HTTPS in production!).
COORDINATOR_URL=https://coordinator.example.com

# One of the tokens listed in COORDINATOR_API_TOKENS on the coordinator side.
PROBER_API_TOKEN=replace-me-prober-1
