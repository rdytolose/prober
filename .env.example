# Coordinator
COORDINATOR_HOST=0.0.0.0
COORDINATOR_PORT=8080
COORDINATOR_DB_URL=sqlite+aiosqlite:///./data/coordinator.db
# Comma-separated tokens that probers must present to register / pull jobs / push results
COORDINATOR_API_TOKENS=changeme-token-1,changeme-token-2
# Token used by admin clients to submit jobs and view results
COORDINATOR_ADMIN_TOKEN=changeme-admin

# Prober
PROBER_NAME=prober-1
PROBER_HOST=0.0.0.0
PROBER_PORT=8090
COORDINATOR_URL=http://coordinator:8080
PROBER_API_TOKEN=changeme-token-1
# Local SOCKS port that sing-box exposes for each test (kept short-lived).
PROBER_LOCAL_SOCKS_PORT=10808
# How many connection URLs to test in parallel (each one still spins up its own sing-box instance).
PROBER_CONCURRENCY=1
# Path to the sing-box binary (must be installed in the container / host).
SINGBOX_BIN=sing-box
# Path to the openvpn binary (optional, only needed if you want openvpn:// support).
OPENVPN_BIN=openvpn
# Per-site request timeout (seconds)
PROBER_SITE_TIMEOUT=10
# Per-link total timeout (seconds), including engine startup
PROBER_LINK_TIMEOUT=45
