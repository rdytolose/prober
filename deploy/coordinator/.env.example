# Coordinator deployment template.  Copy to .env and fill in.
DOMAIN=coordinator.example.com
ACME_EMAIL=you@example.com

# Comma-separated list of tokens that probers must present.
# Generate with:  openssl rand -hex 24
COORDINATOR_API_TOKENS=replace-me-prober-1,replace-me-prober-2

# Token for admin operations (submit job, view dashboard).
# Generate with:  openssl rand -hex 32
COORDINATOR_ADMIN_TOKEN=replace-me-admin
